#!/bin/sh
# Humans may push normally; Codex executions may not.
# Agents must never remove/spoof execution markers or bypass this guard.
if [ -n "${CODEX_THREAD_ID:-}${CODEX_SESSION_ID:-}${CODEX_TOOL_CALL_ID:-}${CODEX_CI:-}${CODEX_SANDBOX:-}" ]; then
    printf '%s\n' \
        'Push blocked for Codex: only the user may push reviewed commits.' \
        'The user can use VS Code Source Control or their own terminal normally.' >&2
    exit 1
fi
exit 0
